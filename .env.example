# Server Port
PORT=3000
HOST=0.0.0.0

# Database
#
# Neko-Router supports SQLite, PostgreSQL and MySQL. Pick one by setting
# DATABASE_URL — the scheme selects the driver, and DB_DRIVER is only needed to
# override that when a URL scheme is ambiguous or non-standard.
#
#   SQLite      file:./data/router.db
#               or the legacy DB_PATH=data/router.db
#   PostgreSQL  postgresql://user:pass@host:5432/nekorouter
#   MySQL       mysql://user:pass@host:3306/nekorouter
#
# Notes per engine:
#  - SQLite opens the file in WAL mode and checkpoints on export. `file:` is
#    optional; a bare path is accepted. Use `:memory:` for a throwaway database.
#  - PostgreSQL reads `sslmode` from the URL with libpq semantics:
#      require / prefer   encrypt, do not verify the certificate
#      verify-ca          verify against a CA given by sslrootcert
#      verify-full        verify against the system trust store
#      disable            no TLS
#    Managed providers (Aiven, RDS, Cloud SQL, Neon, Supabase) reject
#    cleartext connections, so `?sslmode=require` is required there. The
#    equivalent environment variable PGSSLMODE is honoured as well, and is
#    the cleaner choice on hosts where you would rather not put a query
#    string in the URL. For a provider whose CA is not in the system trust
#    store, supply it: ?sslrootcert=/path/ca.pem&sslmode=verify-full
#  - MySQL connections are pooled, as are PostgreSQL ones.
#
# Backups are portable across engines: PostgreSQL and MySQL export a JSON
# document that any engine can import. Only a SQLite export is a raw file copy.
DATABASE_URL=file:./data/router.db

# Force a driver instead of inferring one from the DATABASE_URL scheme.
# One of: sqlite, postgresql, mysql
DB_DRIVER=

# SQLite-only. Used when DATABASE_URL is unset. Ignored for the networked
# engines, which take their path from the URL.
DB_PATH=data/router.db

# JWT Secret for Session Signing.
# LEAVE THIS BLANK. Neko-Router generates a cryptographically random 256-bit
# secret on first boot and persists it in the database (the `jwt_secret` row in
# the settings table). It is only read here when this variable is explicitly set,
# so the value must be unique per deployment.
# Never commit a real secret to version control.
JWT_SECRET=

# Node Environment
NODE_ENV=production

# SSRF protection for upstream requests (optional).
# By default the gateway refuses to send requests to loopback targets
# (localhost, 127.0.0.0/8, ::1) — this blocks same-host service probing and
# cloud metadata endpoints. Link-local, multicast, reserved and other
# non-routable destinations are always blocked. Private LAN addresses
# (RFC1918, e.g. Docker/Ollama on 192.168.x.x) stay allowed.
# Set to 1 ONLY if you run an upstream on the same host (e.g. Ollama on
# localhost:11434 with host networking) and accept the trade-off.
ALLOW_LOOPBACK_UPSTREAMS=

# Cloudflare Turnstile (optional). Leave BOTH blank to keep it disabled.
# Do not use Cloudflare's public testing keys (1x000...AA) on a real deployment:
# they accept every challenge, which silently disables the protection entirely.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=