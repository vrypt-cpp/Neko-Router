# Server Port
PORT=3000
HOST=0.0.0.0

# Database Storage Path
DB_PATH=data/router.db

# JWT Secret for Session Signing.
# LEAVE THIS BLANK. Neko-Router generates a cryptographically random 256-bit
# secret on first boot and persists it in the database (the `jwt_secret` row in
# the settings table). It is only read here when this variable is explicitly set,
# so the value must be unique per deployment.
# Never commit a real secret to version control.
JWT_SECRET=

# Node Environment
NODE_ENV=production

# SSRF protection for upstream requests (optional).
# By default the gateway refuses to send requests to loopback targets
# (localhost, 127.0.0.0/8, ::1) — this blocks same-host service probing and
# cloud metadata endpoints. Link-local, multicast, reserved and other
# non-routable destinations are always blocked. Private LAN addresses
# (RFC1918, e.g. Docker/Ollama on 192.168.x.x) stay allowed.
# Set to 1 ONLY if you run an upstream on the same host (e.g. Ollama on
# localhost:11434 with host networking) and accept the trade-off.
ALLOW_LOOPBACK_UPSTREAMS=

# Cloudflare Turnstile (optional). Leave BOTH blank to keep it disabled.
# Do not use Cloudflare's public testing keys (1x000...AA) on a real deployment:
# they accept every challenge, which silently disables the protection entirely.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=